<!DOCTYPE html>
<html lang="en">
    <head>
    <title>LMS Activation Email</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- css -->
    <style type="text/css">
        /* base */
        body {
            margin: 0;
            padding: 0;
            min-width: 100%;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 16px;
            line-height: 1.5;
            background-color: #FAFAFA;
            color: #222222;
        }
        a {
            color: #000;
            text-decoration: none;
        }
        h1 {
            font-size: 24px;
            font-weight: 700;
            line-height: 1.25;
            margin-top: 0;
            margin-bottom: 15px;
            text-align: center;
        }
        p {
            margin-top: 0;
            margin-bottom: 24px;
        }
        table td {
            vertical-align: top;
        }
        /* layouts */
        .emailWrapper {
            max-width: 600px;
            margin: 0 auto;
        }
        .emailHeader {
            background-color: #0070f3;
            padding: 24px;
            background-color: #ffffff;
        }
        .emailBody {
            padding: 24px;
            background-color: #ffffff;
        }
        .emailFooter {
            padding: 24px;
            background-color: #f6f6f6;
        }
        /* buttons */
        .button {
            display: inline-block;
            background-color: #0070f3;
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="emailWrapper">
        <div class="emailHeader">
            <h1>Welcome to LMS</h1>
        </div>
        <div class="emailBody">
            <p>Hello <%= user.name %>,</p>
            <p>Thank you for registering with LMS. To activate your account, please use the following activation code:</p>
            <h2><%= activationCode %></h2>
            <p>Please enter this code on the activation page within the next <b>3 minutes.</b></p>
            <p>If you do not register for a LMS account, please ignore this email.</p>
        </div>
        <div class="emailFooter">
            <p>If you have any questions, please contact with us at <a href="">support@gmail.com</a></p>
        </div>
    </div>
</body>
</html>