import { VscVerifiedFilled } from "react-icons/vsc";
import { useSelector } from "react-redux";
import { useCreatePaymentIntentMutation } from "@/redux/features/orders/orderApi";
import { loadStripe } from "@stripe/stripe-js";

type Props = {
    data: any;
    setRoute: any;
    setOpen: any;
};

const AboutCourse = ({ data, setRoute, setOpen: openAuthModal }: Props) => {
    const { user } = useSelector((state: any) => state.auth);
    const [openPaymentModal, setOpenPaymentModal] = useState(false);
    const [clientSecret, setClientSecret] = useState<string | null>(null);
    const [stripePromise, setStripePromise] = useState<any>(null);
    const [
        createPaymentIntent,
        { data: paymentIntentData, error: paymentIntentError },
    ] = useCreatePaymentIntentMutation();

    const discountPercentenge =
        ((data?.estimatedPrice - data.price) / data?.estimatedPrice) * 100;

    const discountPercentengePrice = discountPercentenge.toFixed(0);

    const isPurchased =
        user && user?.courses?.find((item: any) => item._id === data._id);

    useEffect(() => {
        const initializeStripe = async () => {
            const { publishablekey } = await fetch("/api/stripe/config").then(
                (res) => res.json()
            );
            setStripePromise(
                publishablekey ? loadStripe(publishablekey) : null
            );
        };

        initializeStripe();
    }, []);

    useEffect(() => {
        if (paymentIntentData?.client_secret) {
            setClientSecret(paymentIntentData.client_secret);
        }
        if (paymentIntentError) {
            console.error("Error creating payment intent:", paymentIntentError);
            // Handle the error appropriately (e.g., display a message to the user)
        }
    }, [paymentIntentData, paymentIntentError]);

    const handleOrder = async (e: any) => {
        if (user) {
            // Create payment intent on the backend
            await createPaymentIntent(data.price * 100); // Amount in cents
            setOpenPaymentModal(true);
        } else {
            setRoute("Login");
            openAuthModal(true);
        }
    };

    return (
        <div className="bg-background-Theme pt-24">
            {/* ... other parts of your component ... */}

            <>
                {openPaymentModal && (
                    <div className="w-full h-screen bg-[#00000036] fixed top-0 left-0 z-50 flex items-center justify-center">
                        <div className="w-[500px] min-h-[500px] bg-white rounded-xl shadow p-3">
                            <div className="w-full flex justify-end">
                                <IoCloseOutline
                                    size={40}
                                    className="text-black cursor-pointer"
                                    onClick={() => setOpenPaymentModal(false)}
                                />
                            </div>

                            <div className="w-full">
                                {console.log(
                                    "Inside modal - stripePromise:",
                                    stripePromise,
                                    "clientSecret:",
                                    clientSecret
                                )}
                                {stripePromise && clientSecret && (
                                    <Elements
                                        stripe={stripePromise}
                                        options={{ clientSecret }}
                                    >
                                        <CheckoutForm
                                            setOpen={setOpenPaymentModal}
                                            data={data}
                                        />
                                    </Elements>
                                )}
                            </div>
                        </div>
                    </div>
                )}
            </>
        </div>
    );
};

export default AboutCourse;
